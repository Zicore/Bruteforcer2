{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "process",
            "command": "dotnet",
            "args": ["build", "${workspaceFolder}/Bruteforcer2.sln", "--configuration", "Debug"],
            "problemMatcher": "$msCompile",
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "build-release",
            "type": "process",
            "command": "dotnet",
            "args": ["build", "${workspaceFolder}/Bruteforcer2.sln", "--configuration", "Release"],
            "problemMatcher": "$msCompile",
            "group": "build"
        }
    ]
}
